run(function()
    local Freecam, Speed
    local freecamPosition
    local randomkey = "LionRayfieldFreecam"

    local function isFreecamDown(...)
        for _, k in ipairs({...}) do
            if UserInputService:IsKeyDown(k) then return true end
        end
        return false
    end

    Freecam = Render:AddModule({
        Name = "Freecam",
        Function = function(callback)
            if callback then
                local camera = workspace.CurrentCamera
                freecamPosition = camera and camera.CFrame.Position or Vector3.zero
                RunService:BindToRenderStep(randomkey, Enum.RenderPriority.Camera.Value + 1, function(dt)
                    local cam = workspace.CurrentCamera
                    if not cam then return end
                    local rot = cam.CFrame - cam.CFrame.Position
                    local move = Vector3.zero
                    if isFreecamDown(Enum.KeyCode.W) then move += Vector3.new(0, 0, -1) end
                    if isFreecamDown(Enum.KeyCode.S) then move += Vector3.new(0, 0, 1) end
                    if isFreecamDown(Enum.KeyCode.A) then move += Vector3.new(-1, 0, 0) end
                    if isFreecamDown(Enum.KeyCode.D) then move += Vector3.new(1, 0, 0) end
                    if isFreecamDown(Enum.KeyCode.E) then move += Vector3.new(0, 1, 0) end
                    if isFreecamDown(Enum.KeyCode.Q) then move += Vector3.new(0, -1, 0) end
                    local spd = Speed and Speed.Value or 50
                    if move.Magnitude > 0 then
                        freecamPosition += rot:VectorToWorldSpace(move.Unit) * spd * dt
                    end
                    cam.CFrame = CFrame.new(freecamPosition) * rot
                end)
            else
                pcall(function() RunService:UnbindFromRenderStep(randomkey) end)
            end
        end
    })

    Speed = Freecam:AddSlider({ Name = "Speed", Min = 10, Max = 300, Default = 60, Suffix = " studs/s" })
end)

