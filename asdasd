-- 카탈로그 시스템 호환을 위한 래퍼 함수 정의
function mainapi:AddCatalog(arg)
    local name = arg["Name"]
    local targetTab = Tabs.Main
    if name == "Render" then targetTab = Tabs.Visuals
    elseif name == "Movement" then targetTab = Tabs.Character
    elseif name == "Player" then targetTab = Tabs.Esp
    elseif name == "Other" then targetTab = Tabs.Misc
    elseif name == "Combat" then targetTab = Tabs.Main end

    return {
        Name = name,
        Modules = {},
        AddModule = function(self, modArg)
            local modName = modArg["Name"]
            local enabledFlag = modArg["Enabled"] or modArg["Default"] or false
            local func = modArg["Function"] or function() end

            local section = targetTab:CreateSection(modName)
            local Module = {
                Name = modName,
                Enabled = enabledFlag,
                Function = func,
                Settings = {}
            }

            local toggle = targetTab:CreateToggle({
                Name = "Enable " .. modName,
                CurrentValue = enabledFlag,
                Flag = modName .. "_Toggle",
                Callback = function(val)
                    Module.Enabled = val
                    task.spawn(function()
                        pcall(func, val)
                    end)
                    pcall(SaveConfig)
                end
            })

            function Module:Toggle(val)
                if val == nil then val = not Module.Enabled end
                toggle:Set(val)
            end

            function Module:SetBind(key)
                Module.Bind = key
            end

            function Module:AddToggle(optArg)
                local optName = optArg["Name"] or optArg["Text"] or "Option"
                local optDef = optArg["Enabled"] or optArg["Default"] or false
                local optFunc = optArg["Function"] or optArg["function"] or function() end

                local subToggle = targetTab:CreateToggle({
                    Name = optName,
                    CurrentValue = optDef,
                    Flag = modName .. "_" .. optName,
                    Callback = function(val)
                        task.spawn(function()
                            pcall(optFunc, val)
                        end)
                    end
                })

                local settingObj = {
                    Name = optName,
                    Enabled = optDef,
                    Toggle = function(_, v) subToggle:Set(v) end,
                    Save = function(_, tab) tab[optName] = {Enabled = subToggle.CurrentValue} end,
                    Load = function(_, tab) if tab and tab.Enabled ~= nil then subToggle:Set(tab.Enabled) end end
                }
                Module.Settings[optName] = settingObj
                return settingObj
            end

            function Module:AddSlider(optArg)
                local optName = optArg["Name"] or "Value"
                local minVal = optArg["Min"] or optArg["min"] or 0
                local maxVal = optArg["Max"] or optArg["max"] or 100
                local defVal = optArg["default"] or optArg["Default"] or optArg["Value"] or minVal
                local optFunc = optArg["Function"] or optArg["function"] or function() end

                local subSlider = targetTab:CreateSlider({
                    Name = optName,
                    Range = {minVal, maxVal},
                    Increment = optArg["Decimal"] or 1,
                    Suffix = optArg["Suffix"] or "",
                    CurrentValue = defVal,
                    Flag = modName .. "_" .. optName,
                    Callback = function(val)
                        task.spawn(function()
                            pcall(optFunc, val)
                        end)
                    end
                })

                local settingObj = {
                    Name = optName,
                    Value = defVal,
                    Save = function(_, tab) tab[optName] = {Value = subSlider.CurrentValue} end,
                    Load = function(_, tab) if tab and tab.Value ~= nil then subSlider:Set(tab.Value) end end
                }
                Module.Settings[optName] = settingObj
                return settingObj
            end

            function Module:AddDropdown(optArg)
                local optName = optArg["Name"] or "Value"
                local list = optArg["List"] or optArg["Values"] or {}
                local defVal = optArg["Default"] or optArg["Value"] or list[1]
                local optFunc = optArg["Function"] or optArg["function"] or function() end

                local subDrop = targetTab:CreateDropdown({
                    Name = optName,
                    Options = list,
                    CurrentOption = defVal,
                    Flag = modName .. "_" .. optName,
                    Callback = function(val)
                        task.spawn(function()
                            pcall(optFunc, val)
                        end)
                    end
                })

                local settingObj = {
                    Name = optName,
                    Value = defVal,
                    Save = function(_, tab) tab[optName] = {Value = subDrop.CurrentValue} end,
                    Load = function(_, tab) if tab and tab.Value ~= nil then subDrop:Set(tab.Value) end end
                }
                Module.Settings[optName] = settingObj
                return settingObj
            end

            function Module:AddDropdown2(optArg) return self:AddDropdown(optArg) end

            function Module:AddInputBox(optArg)
                local optName = optArg["Name"] or optArg["Text"] or "Input"
                local defVal = optArg["Default"] or optArg["Value"] or ""
                local optFunc = optArg["Function"] or optArg["function"] or function() end

                local subInput = targetTab:CreateInput({
                    Name = optName,
                    PlaceholderText = optArg["Placeholder"] or "",
                    CurrentValue = tostring(defVal),
                    Flag = modName .. "_" .. optName,
                    Callback = function(val)
                        task.spawn(function()
                            pcall(optFunc, val)
                        end)
                    end
                })

                local settingObj = {
                    Name = optName,
                    Value = defVal,
                    Save = function(_, tab) tab[optName] = {Value = subInput.CurrentValue} end,
                    Load = function(_, tab) if tab and tab.Value ~= nil then subInput:Set(tostring(tab.Value)) end end
                }
                Module.Settings[optName] = settingObj
                return settingObj
            end

            function Module:AddLabel(optArg)
                local text = type(optArg) == "table" and (optArg["Text"] or "") or tostring(optArg or "")
                targetTab:CreateLabel(text)
            end

            function Module:AddColorPicker(optArg)
                local optName = optArg["Name"] or optArg["Text"] or "Color"
                local defVal = optArg["Default"] or optArg["Value"] or Color3.fromRGB(255, 255, 255)
                local optFunc = optArg["Function"] or optArg["function"] or function() end
                
                -- Rayfield는 기본적으로 컬러피커를 지원하므로 라벨 혹은 토글 형태로 연동
                targetTab:CreateLabel(optName .. " (Color Picker Configured)")
            end

            function Module:AddButton(optArg)
                local text = typeof(optArg) == "table" and (optArg["Text"] or optArg["Name"] or "Button") or tostring(optArg)
                local func = typeof(optArg) == "table" and (optArg["Func"] or optArg["Function"] or function() end) or function() end

                targetTab:CreateButton({
                    Name = text,
                    Callback = func
                })
            end

            mainapi.Modules[modName] = Module
            return Module
        end
    }
end

