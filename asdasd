		local data = Reference[ent]
		if data then
			removeESPObjects(data)
			Reference[ent] = nil
		end
	end

	ESP = Render:AddModule({
		Name = 'ESP',
		Function = function(callback)
			if callback then
				for _, v in ipairs(entitylib.List) do createDrawingESP(v) end
				ESP:Clean(entitylib:GetEvent("EntityAdded"):Connect(createDrawingESP))
				ESP:Clean(entitylib:GetEvent("EntityRemoved"):Connect(removeDrawingESP))

				RunService:BindToRenderStep("LionRayfieldESP", 2000, function()
					local cam = workspace.CurrentCamera
					if not cam then return end

					for ent, drawings in pairs(Reference) do
						local root = ent.RootPart
						if not root or not ent.Character or not ent.Character.Parent then
							setESPVisible(drawings, false)
							continue
						end

						local pos, vis = cam:WorldToViewportPoint(root.Position)
						if not vis then
							setESPVisible(drawings, false)
							continue
						end

						local topPos = cam:WorldToViewportPoint((root.CFrame * CFrame.new(0, ent.HipHeight or 2, 0)).Position)
						local bottomPos = cam:WorldToViewportPoint((root.CFrame * CFrame.new(0, -(ent.HipHeight or 2), 0)).Position)
						local sizeY = math.abs(topPos.Y - bottomPos.Y)
						local sizeX = sizeY * 0.6
						local posX, posY = pos.X - sizeX / 2, topPos.Y

						local color = getESPColor(ent)

						if BoundingBox and BoundingBox.Enabled then
							drawings.Main.Visible = true
							drawings.Main.Color = color
							drawings.Main.Position = Vector2.new(posX, posY)
							drawings.Main.Size = Vector2.new(sizeX, sizeY)
						else
							drawings.Main.Visible = false
						end

						if Filled and Filled.Enabled then
							drawings.Fill.Visible = true
							drawings.Fill.Color = color
							drawings.Fill.Position = Vector2.new(posX, posY)
							drawings.Fill.Size = Vector2.new(sizeX, sizeY)
						else
							drawings.Fill.Visible = false
						end

						if HealthBar and HealthBar.Enabled then
							local hp = math.clamp(ent.Health / ent.MaxHealth, 0, 1)
							drawings.HealthLine.Visible = true
							drawings.HealthLine.Color = Color3.fromHSV(hp * 0.3, 1, 1)
							drawings.HealthLine.From = Vector2.new(posX - 4, posY + sizeY)
							drawings.HealthLine.To = Vector2.new(posX - 4, posY + sizeY - (sizeY * hp))
						else
							drawings.HealthLine.Visible = false
						end

						if Name and Name.Enabled then
							drawings.Text.Visible = true
							drawings.Text.Color = Color3.fromRGB(255, 255, 255)
							drawings.Text.Text = ent.Player and ent.Player.Name or ent.Character.Name
							drawings.Text.Position = Vector2.new(pos.X, posY - 20)
						else
							drawings.Text.Visible = false
						end
					end
				end)
				ESP:Clean({ Disconnect = function() RunService:UnbindFromRenderStep("LionRayfieldESP") end })
			else
				for ent in pairs(Reference) do removeDrawingESP(ent) end
			end
		end
	})

	BoundingBox = ESP:AddToggle({ Name = 'Box', Default = true })
	Filled = ESP:AddToggle({ Name = 'Box Fill', Default = false })
	HealthBar = ESP:AddToggle({ Name = 'Health Bar', Default = true })
	Name = ESP:AddToggle({ Name = 'Name Text', Default = true })
end)

run(function()
	local AimAssist, FOV, Speed, RangeCircle, ClosestPart
	local CircleObject
	local Camera = workspace.CurrentCamera

	local function ensureCircle()
		if not CircleObject and Drawing then
			CircleObject = Drawing.new("Circle")
			CircleObject.Filled = false
			CircleObject.Color = Color3.fromRGB(255, 255, 255)
			CircleObject.Radius = FOV and FOV.Value or 120
			CircleObject.Thickness = 1.5
			CircleObject.Visible = false
		end
	end

	local function removeCircle()
		if CircleObject then
			pcall(function() CircleObject.Visible = false CircleObject:Remove() end)
			CircleObject = nil
		end
	end

	local function getTarget()
		local mouse = UserInputService:GetMouseLocation()
		local best, bestDist = nil, (FOV and FOV.Value or 120)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local hum = plr.Character:FindFirstChildOfClass("Humanoid")
				local part = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
				if hum and hum.Health > 0 and part then
					local pos, vis = Camera:WorldToViewportPoint(part.Position)
					if vis then
						local dist = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
						if dist < bestDist then
							bestDist = dist
							best = part
						end
					end
				end
			end
		end
		return best
	end

	AimAssist = Combat:AddModule({
		Name = "Aim Assist",
		Function = function(enabled)
			if enabled then
				if RangeCircle and RangeCircle.Enabled then ensureCircle() end
				AimAssist:Clean(RunService.RenderStepped:Connect(function(dt)
					local mouse = UserInputService:GetMouseLocation()
					if CircleObject then
						CircleObject.Position = mouse
						CircleObject.Visible = AimAssist.Enabled and (RangeCircle and RangeCircle.Enabled)
						CircleObject.Radius = FOV and FOV.Value or 120
					end

					if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
						local target = getTarget()
						if target then
							local pos = Camera:WorldToViewportPoint(target.Position)
							local diff = (Vector2.new(pos.X, pos.Y) - mouse)
							local smooth = math.clamp((Speed and Speed.Value or 50) / 100, 0.01, 1)
							mousemoverel(diff.X * smooth * dt * 30, diff.Y * smooth * dt * 30)
						end
					end
				end))
			else
				removeCircle()
			end
		end
	})

	FOV = AimAssist:AddSlider({ Name = 'FOV Radius', Min = 10, Max = 800, Default = 120, Suffix = ' px' })
	Speed = AimAssist:AddSlider({ Name = 'Smoothing Speed', Min = 1, Max = 100, Default = 50, Suffix = '%' })
	RangeCircle = AimAssist:AddToggle({ Name = 'Show Circle', Default = true })
end)

