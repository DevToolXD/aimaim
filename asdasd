function mainapi:AddCatalog(arg)
    local catalogName = arg["Name"] or "Misc"
    local targetTab = RayTabs[catalogName] or RayTabs.Other

    local Catalog = {
        Name = catalogName,
        Modules = {}
    }

    function Catalog:AddModule(modArg)
        local moduleName = modArg["Name"] or "Unnamed"
        local hideEnabled = modArg["HideEnabled"] or modArg["NoEnabled"] or false
        local defaultEnabled = modArg["Enabled"] or modArg["Default"] or false
        local func = modArg["Function"] or function() end

        local Module = {
            Name = moduleName,
            Enabled = hideEnabled or defaultEnabled,
            Function = func,
            Settings = {},
            Connections = {},
            Bind = nil,
            Colors = modArg["Colors"] or (modArg["Color"] and {modArg["Color"]}) or {Color3.new(1,1,1), Color3.new(1,1,1), Color3.new(1,1,1)},
            ColorTransparency = modArg["ColorTransparency"] or {0, 0, 0},
            Value = modArg["Color"] or Color3.fromRGB(255, 255, 255),
            Frame = {Visible = true}
        }
        addMaid(Module)

        targetTab:CreateSection(moduleName)

        local mainToggle
        if not hideEnabled then
            mainToggle = targetTab:CreateToggle({
                Name = "Enable " .. moduleName,
                CurrentValue = defaultEnabled,
                Flag = "Mod_" .. catalogName .. "_" .. moduleName,
                Callback = function(val)
                    if Module.Enabled == val then return end
                    Module.Enabled = val
                    if not val then
                        for _, v in pairs(Module.Connections) do pcall(function() v:Disconnect() end) end
